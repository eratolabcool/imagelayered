{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "imagelayered",
	"keep_names": false,
	"compatibility_date": "2026-01-24",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "imagelayered"
		}
	],
	"d1_databases": [
		{ "binding": "DB", "database_name": "imagelayered-db", "database_id": "367ac902-97b9-4098-908c-a9ea81d99537" }
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"vars": {
		"NEXT_PUBLIC_APP_URL": "https://image-layered.app",
		"WECHAT_MINI_APP_ID": "wx0465a2d15b9c968b",
		"NEXT_PUBLIC_APP_NAME": "Image Layered",
		"NEXT_PUBLIC_THEME": "default",
		"NEXT_PUBLIC_APPEARANCE": "dark",
		"DATABASE_PROVIDER": "d1",
		"DB_SINGLETON_ENABLED": "true",
		"DB_MAX_CONNECTIONS": "1"
	}
}
